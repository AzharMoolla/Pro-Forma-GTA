{
  "name": "gta-proforma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test",
    "report": "tsx scripts/report.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "geo": "tsx scripts/fetch-geo.ts",
    "map:collect": "node scripts/collect-planning-map.mjs",
    "map:collect:regional": "node scripts/collect-planning-map-arcgis.mjs",
    "map:preview": "node --import tsx scripts/planning-map-preview.mjs",
    "map:verify": "node --import tsx scripts/verify-planning-map.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "shpjs": "6.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
